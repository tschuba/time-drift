{
  "name": "time-drift",
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "concurrently \"node --env-file=.env --import=tsx/esm --watch src/index.tsx\" \"tailwindcss -i src/styles/app.css -o public/css/app.css --watch\"",
    "build": "tsup && tailwindcss -i src/styles/app.css -o public/css/app.css --minify",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "node scripts/copy-htmx.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "decimal.js": "^10.4.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "daisyui": "^5.7.50",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.1.0",
    "tsup": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
