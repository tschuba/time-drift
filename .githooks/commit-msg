#!/usr/bin/env sh
commit_msg=$(cat "$1")

# Skip merge, revert, fixup, and squash commits
case "$commit_msg" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert)(\(.+\))?: .+'

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo ""
  echo "ERROR: Commit-Nachricht entspricht nicht dem Conventional Commits Format."
  echo "Erwartet: <typ>[optionaler scope]: <beschreibung>"
  echo "Typen:    feat, fix, docs, style, refactor, test, chore, perf, ci, build, revert"
  echo ""
  echo "Deine Nachricht: $commit_msg"
  echo ""
  exit 1
fi
